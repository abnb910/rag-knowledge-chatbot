# Copy to .env and fill in. Get a free key from Google AI Studio.
GEMINI_API_KEY=

# Optional overrides — check Google AI Studio for current model IDs.
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

